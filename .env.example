# VoiceLab Desktop

# Marketing / BFF origin (account UI, social OAuth callback host)
VITE_AUTH_URL=https://voicelab.uz
# Optional trusted site origin used for system-browser Desktop authorization.
# It must also be listed in VOICELAB_DESKTOP_AUTH_ORIGINS.
VOICELAB_DESKTOP_AUTH_URL=https://voicelab.uz

# VoiceLab account API (desktop auth, wallet, and Dictate operations)
VITE_AUTH_API_URL=https://api.voicelab.uz
VOICELAB_DESKTOP_API_URL=https://api.voicelab.uz

# Renderer-side VoiceLab API origin used by legacy screens.
VITE_VOICELAB_API_URL=https://api.voicelab.uz

# Desktop deep-link protocol (electron-builder schemes: voicelab)
OPENWHISPR_PROTOCOL=voicelab
VITE_OPENWHISPR_PROTOCOL=voicelab

# Optional UI language (uz, en, ru, …)
UI_LANGUAGE=uz

# Optional BYOK providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TINFOIL_API_KEY=
MISTRAL_API_KEY=

OPENWHISPR_LOG_LEVEL=info
