# VoiceLab Desktop

# Marketing / BFF origin (account UI, social OAuth callback host)
VITE_AUTH_URL=https://voicelab.uz

# Account JWT API (login/me/refresh) — not the Aisha STT host
VITE_AUTH_API_URL=https://api.voicelab.uz

# Cloud speech API base — Aisha backend (docs: https://aisha.group/uz/api-documentation)
# Prefer this over legacy OpenWhispr /api/transcribe
VITE_VOICELAB_API_URL=https://back.aisha.group
# Legacy alias still accepted:
# VITE_OPENWHISPR_API_URL=

# Aisha API key (X-Api-Key). Each user enters their own key in onboarding /
# Settings → Account from https://space.aisha.group
# Optional for local/dev only — do NOT ship a shared key in packaged builds.
# Do NOT use VITE_ prefix — keep the key out of the renderer bundle.
AISHA_API_KEY=

# Desktop deep-link protocol (electron-builder schemes: voicelab)
OPENWHISPR_PROTOCOL=voicelab
VITE_OPENWHISPR_PROTOCOL=voicelab

# Optional UI language (uz, en, ru, …)
UI_LANGUAGE=uz

# Optional BYOK providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TINFOIL_API_KEY=
MISTRAL_API_KEY=

OPENWHISPR_LOG_LEVEL=info
